syntax = "v1"

// goctl api go --api user.api --dir .
// goctl api validate --api user.api
// goctl api ts --api user.api --dir tscode
@server (
	group:      user
	prefix:     api/user/v1
	middleware: ChangePasswordLimit
)
service user-api {
	// 修改密码
	@handler changePassword
	post /changepassword (ChangePasswordReq) returns (ChangePasswordResp)
}

// 无认证服务接口
@server (
	group:      user_noauth
	prefix:     api/user/v1/noauth
	middleware: NoAuthLimit
)
service user-api {
	// 验证码
	@handler sendVerifyCode
	post /verifycode (SendVerifyCodeReq) returns (SendVerifyCodeResp)

	// 邮箱注册
	@handler register
	post /register (RegisterReq) returns (RegisterResp)

	// 用户找回密码
	@handler resetPassword
	post /resetpassword (ResetPasswordReq) returns (ResetPasswordResp)
}

// 登录接口 - 添加 CookieSetter 中间件
@server (
	group:      user_noauth
	prefix:     api/user/v1/noauth
	middleware: NoAuthLimit,CookieSetter
)
service user-api {
	// 用户登录
	@handler login
	post /login (LoginReq) returns (LoginResp)
}

// 刷新 token 接口 - 添加 CookieSetter 中间件
@server (
	group:      user_noauth
	prefix:     api/user/v1/noauth
	middleware: RefreshTokenLimit,CookieSetter
)
service user-api {
	// 刷新 access + refresh token
	@handler refreshToken
	post /refreshtoken (RefreshTokenReq) returns (RefreshTokenResp)
}

// 登出接口 - 添加 CookieSetter 中间件
@server (
	group:      user_noauth
	prefix:     api/user/v1/noauth
	middleware: CookieSetter
)
service user-api {
	// 用户登出
	@handler logout
	post /logout (LogoutReq) returns (LogoutResp)
}

// JWKS 端点 - 供网关获取公钥验证 JWT 签名
@server (
	group:      jwks
	prefix:     api/user/v1
	middleware: JWKSCacheControl
)
service user-api {
	// 获取 JWKS（JSON Web Key Set）
	@handler jwks
	get /jwks returns (JWKSResp)
}

// 发送验证码请求
type SendVerifyCodeReq {
	Email string `json:"email"` // 邮箱地址
	Type  string `json:"type"` // 验证码类型: register/reset_password/bind_email
}

// 发送验证码响应
type SendVerifyCodeResp {
	RetryAfter int `json:"retryAfter"` // 多少秒后可重发
}

// 验证码内部使用类型
type VerificationCodeMessage {
	Code      string `json:"code"` // 验证码
	Receiver  string `json:"receiver"` // 接收方邮箱
	Type      string `json:"type"` // 验证码类型（注册/登录/重置密码）
	Timestamp int64  `json:"timestamp"` // 时间戳，用于过期判断
}

// 注册请求
type RegisterReq {
	Email    string `json:"email"` // 邮箱
	Password string `json:"password"` // 密码
	Code     string `json:"code"` // 验证码
	Nickname string `json:"nickname"` // 昵称
}

// 注册响应
type RegisterResp {}

// 登录请求
type LoginReq {
	Email      string `json:"email"` // 邮箱
	Password   string `json:"password"` // 密码
	RememberMe bool   `json:"rememberMe"` // 记住我
}

// 登录响应 - Token 通过 Cookie 返回
type LoginResp {
	ExpiresIn int64 `json:"expiresIn"` // AccessToken 有效期，单位:秒
}

// 重置密码请求（发送验证码后，用验证码重置密码）
type ResetPasswordReq {
	Email    string `json:"email"` // 邮箱
	Password string `json:"password"` // 新密码
	Code     string `json:"code"` // 验证码
}

// 重置密码响应
type ResetPasswordResp {}

// 修改密码请求
type ChangePasswordReq {
	OldPassword string `json:"oldPassword"` // 旧密码
	NewPassword string `json:"newPassword"` // 新密码
	Code        string `json:"code"` // 验证码
}

// 修改密码响应
type ChangePasswordResp {}

// 刷新令牌请求 - 从 Cookie 读取 RefreshToken，无需请求体
type RefreshTokenReq {}

// 刷新令牌响应 - Token 通过 Cookie 返回
type RefreshTokenResp {
	ExpiresIn int64 `json:"expiresIn"` // AccessToken 有效期，单位:秒
}

// 登出请求
type LogoutReq {}

// 登出响应
type LogoutResp {}

// JWK（JSON Web Key）结构
type JWK {
	Kty string `json:"kty"` // 密钥类型，如 RSA
	Kid string `json:"kid"` // 密钥标识符
	Use string `json:"use"` // 用途，sig 表示签名
	N   string `json:"n"` // RSA 模数 (base64url 编码)
	E   string `json:"e"` // RSA 指数 (base64url 编码)
	Alg string `json:"alg"` // 算法，如 RS256
}

// JWKS 响应
type JWKSResp {
	Keys []JWK `json:"keys"` // 公钥列表
}

